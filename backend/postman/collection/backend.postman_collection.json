          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/forms/"
          }
        },
        {
          "name": "Create Form",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Formulario creado (201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Guarda los ids generados para usarlos en el resto de requests",
                  "// de este folder y en el de Form Responses.",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('form_id', body.id);",
                  "",
                  "    const textField = body.fields.find(f => f.field_type === 'text');",
                  "    const choiceField = body.fields.find(f => f.field_type === 'single_choice');",
                  "",
                  "    if (textField) { pm.environment.set('field_text_id', textField.id); }",
                  "    if (choiceField) {",
                  "        pm.environment.set('field_choice_id', choiceField.id);",
                  "        if (choiceField.choices && choiceField.choices.length > 0) {",
                  "            pm.environment.set('choice_id', choiceField.choices[0].id);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/forms/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Encuesta Postman\",\n  \"description\": \"Formulario de prueba creado desde Postman\",\n  \"allow_multiple_responses\": false,\n  \"is_active\": true,\n  \"fields\": [\n    {\n      \"label\": \"Observaciones\",\n      \"field_type\": \"text\",\n      \"is_required\": true\n    },\n    {\n      \"label\": \"Zona\",\n      \"field_type\": \"single_choice\",\n      \"is_required\": true,\n      \"choices\": [\n        {\n          \"text\": \"Urbana\"\n        },\n        {\n          \"text\": \"Rural\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Form Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
