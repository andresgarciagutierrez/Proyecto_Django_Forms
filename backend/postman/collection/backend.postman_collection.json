  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Refresca csrf_token si la respuesta trajo una cookie nueva.",
          "// Corre para TODOS los requests de la coleccion, asi que ya no",
          "// hace falta repetir esta captura en cada item individual.",
          "const csrfToken = pm.cookies.get('csrftoken');",
          "if (csrfToken) { pm.environment.set('csrf_token', csrfToken); }"
        ],
        "type": "text/javascript"
      }
    }
