    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Busca todas las URLs de tipo /tasks/<id>/delete/ en el HTML de la respuesta",
                  "const body = pm.response.text();",
                  "const matches = [...body.matchAll(/\\/tasks\\/(\\d+)\\/delete\\//g)];",
                  "if (matches.length > 0) {",
                  "    // Como el modelo no define un ordering explicito en Meta,",
                  "    // Django devuelve las tareas normalmente en orden de insercion,",
                  "    // asi que asumimos que el ULTIMO link corresponde a la tarea mas reciente.",
                  "    const ids = matches.map(m => parseInt(m[1], 10));",
                  "    const lastId = Math.max(...ids);",
                  "    pm.environment.set('task_id', lastId);",
                  "}",
                  "",
                  "pm.test('Lista de tareas accesible (sesion activa)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tasks/"
          }
        },
        {
          "name": "Get New Task Page (CSRF cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [],
