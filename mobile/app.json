{
  "expo": {
    "name": "IRIC Forms",
    "slug": "iric-forms",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/logo-iric-forms.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-iric-forms.png"
    },
    "android": {
      "package": "com.andresfgarciasteam.iricforms",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-iric-forms.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo-iric-forms.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": [
              "arm64-v8a",
              "x86_64"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50f4ea7c-173f-4069-83f8-bc18e36220d2"
      }
    },
    "owner": "andresfgarcias-team"
  }
}
